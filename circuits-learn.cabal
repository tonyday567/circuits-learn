cabal-version: 3.0
name: circuits-learn
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: math
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-learn#readme
bug-reports: https://github.com/tonyday567/circuits-learn/issues
synopsis: Adam and EWMA optimisers as Processes
description:
  Reference oracles for Adam and exponentially-weighted moving average
  (EWMA) optimisers expressed as 'Process' coalgebras. Non-zero exit
  on mismatch with hand recurrences.

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-learn

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common ghc2024-stanza
  default-language: GHC2024

library
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: src
  exposed-modules:
    Circuit.Learn.Adam
    Circuit.Learn.Ephemeral
    Circuit.Learn.Fit
    Circuit.Learn.Para

  build-depends:
    base >=4.18 && <5,
    circuits >=0.2 && <0.5,
    profunctors >=5.6.3 && <6,

executable circuits-learn-axioma
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: axioma.hs
  build-depends:
    base >=4.18 && <5,
    circuits,
    circuits-learn,
